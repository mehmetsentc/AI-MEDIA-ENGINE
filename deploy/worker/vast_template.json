{
  "name": "ai-media-engine-image-worker",
  "description": "Runtime-only Vast template. Model weights are not in the image.",
  "image": "ghcr.io/mehmetsentc/ai-media-engine-worker@sha256:25f76c48d3fc6db4571558c8c159b0d59ac243c98c2ab979fada4c86aa680091",
  "image_repository": "ghcr.io/mehmetsentc/ai-media-engine-worker",
  "image_env": "MEDIA_ENGINE_WORKER_IMAGE",
  "auto_start": "python3 /workspace/worker_ready.py",
  "ssh_required_for_bootstrap": false,
  "runtype": "ssh",
  "ssh": true,
  "jupyter": false,
  "disk_gb": {
    "warm_cache": 40,
    "r2_cold_stage": 140
  },
  "env": {
    "HF_HOME": "/models/hf-cache",
    "HUGGINGFACE_HUB_CACHE": "/models/hf-cache",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_HUB_DISABLE_TELEMETRY": "1"
  },
  "onstart": "python3 /workspace/worker_ready.py",
  "python": "3.12",
  "preinstalled": [
    "torch==2.11.0+cu128",
    "diffusers==0.41.0",
    "transformers==5.19.0",
    "accelerate==1.15.0",
    "safetensors==0.8.0",
    "pillow"
  ],
  "worker_code": [
    "/workspace/qwen_remote.py",
    "/workspace/model_cache.py",
    "/workspace/r2_cache.py"
  ],
  "runtime_marker": "/opt/ai-media-engine/runtime-ready",
  "model_weights_baked": false,
  "model_mount": "/models",
  "warm_volume": {
    "id": 54653022,
    "machine_id": 47281,
    "attach": "only when the selected offer is on machine 47281"
  },
  "create_fields": {
    "image": "${MEDIA_ENGINE_WORKER_IMAGE}",
    "disk": "40 on the warm machine, else 140",
    "runtype": "ssh",
    "onstart": "python3 /workspace/worker_ready.py",
    "label": "media-engine:{owner}"
  }
}
